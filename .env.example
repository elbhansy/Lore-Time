# Core Environment: development | test | production
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECURE_32_CHAR_SECRET_KEY!

# API Server Configuration
API_TITLE=Timeline Power Visualizer API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend default story ID when running the Vite app
VITE_DEFAULT_SERIES_ID=a9d1b78b-dcb4-46f7-b0d2-8a8dcf96e177

# CORS Allowed Origins (Comma-separated list or JSON array)
# In production, wildcard '*' and localhost origins are strictly forbidden.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Host & Proxy Security
# In production, wildcard '*' is forbidden; specify exact allowed domain names.
ALLOWED_HOSTS=*
# In production, specify direct reverse proxy IP addresses (e.g., 10.0.0.1, 127.0.0.1)
TRUSTED_PROXIES=127.0.0.1,::1
MAX_REQUEST_BODY_BYTES=1048576

# Database Configuration (PostgreSQL 18)
DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true

# Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Caching Configuration (Phase 4.8)
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=5000
CACHE_MAX_ENTRY_BYTES=524288
CACHE_MAX_MEMORY_BYTES=67108864
CACHE_DEFAULT_TTL_SECONDS=3600
WORKER_COUNT=1

# Rate Limiting & Abuse Protection (Phase 4.9)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=120
RATE_LIMIT_DEFAULT_BURST=30
RATE_LIMIT_EXPENSIVE_LIMIT=30
RATE_LIMIT_EXPENSIVE_BURST=10
RATE_LIMIT_MUTATING_LIMIT=60
RATE_LIMIT_MUTATING_BURST=15
RATE_LIMIT_MAX_IDENTITIES=10000
RATE_LIMIT_MAX_HITS_PER_IDENTITY=100
RATE_LIMIT_WINDOW_SECONDS=60
